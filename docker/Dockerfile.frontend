FROM node:20-alpine AS build

WORKDIR /app

ARG REACT_APP_API_URL=/api
ARG REACT_APP_1C_DATA_URL
ARG REACT_APP_SEARCH_EQUIPMENT_URL
ARG REACT_APP_ESTIMATE_PRICE_URL
ARG REACT_APP_TKP_ACCESSORIES_URL
ARG REACT_APP_TKP_PDF_URL
ARG REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL
ARG REACT_APP_GRAND_GAS_PRICE_URL

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_1C_DATA_URL=$REACT_APP_1C_DATA_URL
ENV REACT_APP_SEARCH_EQUIPMENT_URL=$REACT_APP_SEARCH_EQUIPMENT_URL
ENV REACT_APP_ESTIMATE_PRICE_URL=$REACT_APP_ESTIMATE_PRICE_URL
ENV REACT_APP_TKP_ACCESSORIES_URL=$REACT_APP_TKP_ACCESSORIES_URL
ENV REACT_APP_TKP_PDF_URL=$REACT_APP_TKP_PDF_URL
ENV REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL=$REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL
ENV REACT_APP_GRAND_GAS_PRICE_URL=$REACT_APP_GRAND_GAS_PRICE_URL

COPY front/chatbot/package*.json ./
RUN npm ci

COPY front/chatbot/ ./
RUN npm run build

FROM nginx:alpine

COPY docker/nginx.master-podbora.conf /etc/nginx/nginx.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
