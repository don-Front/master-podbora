# Скопируйте этот файл в `.env.production` перед production-сборкой.

# CRA встраивает REACT_APP_* значения на этапе `npm run build`.



# Django-чат (hints, messages, RAG) — отдельный хост Django, НЕ turbo-podbor.ru
REACT_APP_API_URL=https://[ТВОЙ_ДОМЕН_DJANGO]/api



# Сервис подбора оборудования (FastAPI) — https://turbo-podbor.ru

REACT_APP_1C_DATA_URL=https://turbo-podbor.ru/api/1c/data

REACT_APP_SEARCH_EQUIPMENT_URL=https://turbo-podbor.ru/api/search-equipment

REACT_APP_ESTIMATE_PRICE_URL=https://turbo-podbor.ru/api/estimate-price

REACT_APP_TKP_ACCESSORIES_URL=https://turbo-podbor.ru/api/tkp-accessories

REACT_APP_TKP_PDF_URL=https://turbo-podbor.ru/api/tkp-pdf

REACT_APP_GRAND_GAS_PRICE_URL=https://turbo-podbor.ru/api/prices/grand-gas-meters

REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL=https://turbo-podbor.ru/api/submit-household-gas-request

REACT_APP_SUBMIT_SPU_APPLICATION_URL=https://turbo-podbor.ru/api/submit-spu-application

