# Слушать на всех интерфейсах — заход с других ПК в LAN: http://192.168.2.225:3001
HOST=0.0.0.0
PORT=3001
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Django-чат: LAN IP машины с Daphne (для доступа с других ПК без proxy)
