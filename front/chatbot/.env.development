# Слушать на всех интерфейсах — заход с других ПК в LAN: http://<IP_этого_ПК>:3000
HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true
# Бэкенд чата (Django). Не указывайте порт 3000 — это dev-сервер React.
# Локально используем 8002, чтобы не конфликтовать с сервисами, случайно занявшими 8000.
REACT_APP_API_URL=http://192.168.5.49:8002
REACT_APP_1C_DATA_URL=http://192.168.5.49:8010/api/1c/data
REACT_APP_ESTIMATE_PRICE_URL=http://192.168.5.49:8010/api/estimate-price
REACT_APP_TKP_ACCESSORIES_URL=http://192.168.5.49:8010/api/tkp-accessories
REACT_APP_TKP_PDF_URL=http://192.168.5.49:8010/api/tkp-pdf
# POST заявки «бытовые счётчики газа» (тот же хост, что и 1С); фактический запрос идёт с Django — для отладки в консоли.
REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL=http://192.168.5.49:8010/api/submit-household-gas-request
