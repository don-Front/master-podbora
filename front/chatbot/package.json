{
  "name": "chatbot",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://127.0.0.1:8002",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "cross-env HOST=0.0.0.0 PORT=3001 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "start:lan": "cross-env HOST=0.0.0.0 PORT=3001 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "serve:lan": "cross-env REACT_APP_USE_API_PROXY=false REACT_APP_API_URL=http://192.168.2.225:8002 npm run build && serve -s build -l tcp://0.0.0.0:3001",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "serve": "^14.2.6"
  }
