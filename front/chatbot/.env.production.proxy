# Production dist for https://master-turbo-podbor.ru (see deploy/nginx-master-turbo-podbor-proxy.conf)
# build: $env:BUILD_PATH='../../dist'; Get-Content .env.production.proxy | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path env:$($matches[1]) -Value $matches[2] } }; npm run build

PUBLIC_URL=/podbor-chat
REACT_APP_API_URL=https://master-turbo-podbor.ru/podbor-api/api
REACT_APP_SEARCH_EQUIPMENT_URL=https://master-turbo-podbor.ru/api/search-equipment
REACT_APP_ESTIMATE_PRICE_URL=https://master-turbo-podbor.ru/api/estimate-price
REACT_APP_TKP_ACCESSORIES_URL=https://master-turbo-podbor.ru/api/tkp-accessories
REACT_APP_TKP_PDF_URL=https://master-turbo-podbor.ru/api/tkp-pdf
REACT_APP_1C_DATA_URL=https://master-turbo-podbor.ru/api/1c/data
REACT_APP_GRAND_GAS_PRICE_URL=https://master-turbo-podbor.ru/api/prices/grand-gas-meters
REACT_APP_SUBMIT_HOUSEHOLD_GAS_URL=https://master-turbo-podbor.ru/api/submit-household-gas-request
REACT_APP_SUBMIT_SPU_APPLICATION_URL=https://master-turbo-podbor.ru/api/submit-spu-application
